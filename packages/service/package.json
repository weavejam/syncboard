    "@fluidframework/tinylicious-client": "^2.103.0",
    "@syncboard/shared": "workspace:*",
    "@vue/compiler-sfc": "^3.5.38",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "fastify": "^5.8.5",
    "fluid-framework": "^2.103.0",
    "nanoid": "^5.1.11",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
